<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.studentrecordmanagementsystem.Controller"
      spacing="10" style="-fx-padding: 20;">

    <TextField fx:id="txtName" promptText="Name"/>
    <TextField fx:id="txtCourse" promptText="Course"/>
    <ChoiceBox fx:id="cbYear" prefWidth="200"/>

    <HBox spacing="10">
        <Button text="Add"    onAction="#addStudent"/>
        <Button text="Update" onAction="#updateStudent"/>
        <Button text="Delete" onAction="#deleteStudent"/>
        <Button text="Clear"  onAction="#clearFields"/>
    </HBox>

    <TableView fx:id="table" prefHeight="400">
        <columns>
            <TableColumn fx:id="colId"     text="ID"         prefWidth="60"/>
            <TableColumn fx:id="colName"   text="Name"       prefWidth="150"/>
            <TableColumn fx:id="colCourse" text="Course"     prefWidth="120"/>
            <TableColumn fx:id="colYear"   text="Year Level" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>